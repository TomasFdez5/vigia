# Copy to .env.local and replace every placeholder. Never commit real values.
# The app refuses to start while a required variable is missing or invalid.

# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.invalid
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me
# Server only: bypasses RLS. Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=replace-me
# At least 32 characters. Generate with: openssl rand -base64 32
CRON_SECRET=replace-me

# --- Optional provider credentials (leave empty to disable the provider) ---
GITHUB_TOKEN=
RENDER_API_KEY=
# One token per Vercel project: VERCEL_TOKEN_<PROJECT_ID>=
